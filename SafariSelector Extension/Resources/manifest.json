{
  "manifest_version": 2,
  "name": "SafariSelector",
  "version": "1.1.0",
  "description": "Lets SafariSelector open links in a chosen Safari window's active tab group.",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "icons": {
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  }
}
